# Copy this file to .env and fill it in. .env is git-ignored. Never put real keys in this file.

# Leave empty to play songs from public/songs (local files).
# Set it to load songs and covers from Cloudinary instead.
# Not a secret: also add it in Netlify > Site settings > Environment variables.
VITE_CLOUDINARY_CLOUD_NAME=

# Only needed for `npm run upload:cloudinary`. SECRET: never commit, never put in Netlify.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: plays iTunes search results in full from YouTube (otherwise 30s previews).
# Google Cloud Console > enable "YouTube Data API v3" > Credentials > API key.
# This key is visible in the website's code, so RESTRICT it: Websites (HTTP referrers) =
# localhost:5173/* and your Netlify URL, and API restriction = YouTube Data API v3.
VITE_YOUTUBE_API_KEY=
